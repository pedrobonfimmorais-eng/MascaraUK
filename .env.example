# Copie este arquivo para .env.local e preencha com os valores do seu projeto.

# Supabase — Configurações > API no painel do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada, nunca exponha no navegador. Usada em rotas de servidor (ex.: webhook do Stripe).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Painel Stripe > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública do site (usada em metadados, links de e-mail, redirecionamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails transacionais (pedido recebido, pagamento confirmado, envio, etc.)
# Painel Resend (https://resend.com) → API Keys. Sem esta chave, os e-mails
# apenas são registrados no log do servidor (não são enviados de verdade).
RESEND_API_KEY=
EMAIL_FROM="MascaraUK <pedidos@seudominio.com>"
# E-mail interno que recebe o aviso de "novo pedido" (painel administrativo)
ADMIN_NOTIFICATION_EMAIL=
