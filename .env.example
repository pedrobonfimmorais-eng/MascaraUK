# Copie este arquivo para .env.local e preencha com os valores reais do seu
# projeto. NUNCA coloque valores reais neste arquivo (.env.example) nem os
# comite no Git — .env.local já está no .gitignore.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# URL pública da loja (metadados, links de e-mail, redirecionamentos, sitemap).
# Em produção, use o domínio real com https://.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambiente atual: development, staging ou production. Ainda não muda nenhum
# comportamento no código automaticamente — hoje serve como documentação do
# ambiente para quem está operando o servidor.
APP_ENV=development

# ---------------------------------------------------------------------------
# Banco de dados / Supabase
# ---------------------------------------------------------------------------
# String de conexão direta ao Postgres (Painel Supabase → Project Settings →
# Database → Connection string). O aplicativo em si não usa esta variável
# diretamente (ele fala com o Supabase via URL + chaves abaixo) — só é
# necessária se você for rodar ferramentas de banco fora do Supabase CLI.
DATABASE_URL=

# URL e chaves do projeto Supabase (Project Settings → API).
# NEXT_PUBLIC_SUPABASE_URL e SUPABASE_URL podem apontar para o mesmo valor —
# a primeira é lida pelo navegador e pelo servidor, a segunda só é usada pelo
# script de terminal scripts/create-admin.mjs.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Chave privada (nunca exponha no navegador nem em código de cliente). Usada
# em Server Actions/rotas administrativas para operações que precisam
# ignorar as políticas de RLS (ex.: webhook do Stripe, painel admin).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Não é necessária: a autenticação é feita inteiramente pelo Supabase Auth
# (sessão/cookies gerenciados por @supabase/ssr), não por uma biblioteca tipo
# NextAuth que exigiria um segredo próprio. Mantida aqui apenas por
# convenção — pode deixar em branco.
AUTH_SECRET=

# Segredo exigido para rodar `npm run create-admin` (ver scripts/create-admin.mjs)
# e criar o primeiro administrador principal da loja. Gere um valor aleatório
# longo. Depois do primeiro admin criado, os próximos administradores são
# convidados de dentro do painel (/admin/administradores), nunca por aqui.
ADMIN_SETUP_SECRET=

# ---------------------------------------------------------------------------
# Stripe (pagamentos)
# ---------------------------------------------------------------------------
# Painel Stripe → Developers → API keys. Use as chaves de TESTE (sk_test_/
# pk_test_) em desenvolvimento e as chaves de PRODUÇÃO (sk_live_/pk_live_)
# somente no ambiente de produção — nunca misture as duas.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Painel Stripe → Developers → Webhooks (ou `stripe listen` em desenvolvimento).
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# E-mail transacional
# ---------------------------------------------------------------------------
# Provedor usado hoje pelo código: Resend (https://resend.com) → API Keys.
# Sem esta chave, os e-mails só são registrados no log do servidor (não são
# enviados de verdade) — a loja continua funcionando normalmente.
EMAIL_PROVIDER_API_KEY=
# Alias lido diretamente pelo código (src/lib/email/send.ts) — preencha com
# o mesmo valor de EMAIL_PROVIDER_API_KEY acima.
RESEND_API_KEY=
EMAIL_FROM="MascaraUK <pedidos@seudominio.com>"
# E-mail interno que recebe o aviso de "novo pedido pago".
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Armazenamento de imagens
# ---------------------------------------------------------------------------
# Não é uma chave separada: imagens de produtos/categorias/banners/logos usam
# o Supabase Storage, autenticado com SUPABASE_SERVICE_ROLE_KEY acima. Mantida
# aqui apenas por documentação — pode deixar em branco.
IMAGE_STORAGE_KEY=

# ---------------------------------------------------------------------------
# Tarefas agendadas
# ---------------------------------------------------------------------------
# Reservada para um futuro endpoint de cron que envie os relatórios agendados
# em /admin/relatorios automaticamente. A tela de agendamento já salva a
# preferência (tipo, frequência, destinatários, formato, horário) no banco,
# mas NENHUM job automático está configurado ainda — nada é enviado sozinho
# até essa peça ser implementada.
CRON_SECRET=

# ---------------------------------------------------------------------------
# CAPTCHA (Cloudflare Turnstile) — proteção contra bots
# ---------------------------------------------------------------------------
# Painel Cloudflare → Turnstile → crie um site e copie as duas chaves.
# Protege login, cadastro, recuperação de senha, contato e aceite de
# convite administrativo (ver src/lib/turnstile.ts). Sem estas variáveis
# preenchidas, o CAPTCHA fica desativado (nenhum widget aparece e a
# verificação no servidor é pulada) — os formulários continuam
# funcionando, só sem a proteção extra; isso é intencional para permitir
# desenvolvimento local sem uma conta Cloudflare, mas NÃO deixe em branco
# em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
